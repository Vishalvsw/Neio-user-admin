import { notFound } from "next/navigation";
import type { Metadata } from "next";

import { CATEGORIES } from "@/lib/categories";
import { LOCATIONS } from "@/lib/locations";
import { SERVICES } from "@/lib/services";
import { SERVICE_REGISTRY } from "@/lib/serviceRegistry";
import {
  getAreasForService,
} from "@/lib/serviceAvailability";

import SubcategoryLayout from "@/components/service/SubcategoryLayout";

interface PageProps {
  params: Promise<{
    city: string;
    category: string;
    subcategory: string;
  }>;
}

/* ============================================================
   STATIC PARAMS
   ============================================================ */

export async function generateStaticParams() {
  const pages: {
    city: string;
    category: string;
    subcategory: string;
  }[] = [];

  for (const city of LOCATIONS) {
    for (const category of CATEGORIES) {
      for (const subcategory of category.subcategories) {
        const serviceData = SERVICES.find(
          (service) => service.slug === subcategory.slug
        );

        if (!serviceData) {
          continue;
        }

        if (
          serviceData.category !== category.slug ||
          serviceData.subcategory !== subcategory.slug
        ) {
          continue;
        }

        const availableAreas = getAreasForService(
          city.slug,
          serviceData.slug
        );

        if (availableAreas.length === 0) {
          continue;
        }

        pages.push({
          city: city.slug,
          category: category.slug,
          subcategory: subcategory.slug,
        });
      }
    }
  }

  return pages;
}

/* ============================================================
   METADATA
   ============================================================ */

export async function generateMetadata({
  params,
}: PageProps): Promise<Metadata> {
  const {
    city,
    category,
    subcategory,
  } = await params;

  const cityData = LOCATIONS.find(
    (item) => item.slug === city
  );

  const categoryData = CATEGORIES.find(
    (item) => item.slug === category
  );

  const subcategoryData =
    categoryData?.subcategories.find(
      (item) => item.slug === subcategory
    );

  const serviceData = SERVICES.find(
    (item) => item.slug === subcategory
  );

  if (
    !cityData ||
    !categoryData ||
    !subcategoryData ||
    !serviceData
  ) {
    return {};
  }

  if (
    serviceData.category !== categoryData.slug ||
    serviceData.subcategory !== subcategoryData.slug
  ) {
    return {};
  }

  const availableAreas = getAreasForService(
    city,
    serviceData.slug
  );

  if (availableAreas.length === 0) {
    return {};
  }

  return {
    title:
      `${serviceData.name} Services in ${cityData.name}`,

    description:
      `Explore ${serviceData.name.toLowerCase()} services in ` +
      `${cityData.name}. View service details, available options, ` +
      `pricing and booking information.`,

    alternates: {
      canonical:
        `https://neoi.in/${city}/services/${category}/${subcategory}`,
    },
  };
}

/* ============================================================
   PAGE
   ============================================================ */

export default async function SubcategoryPage({
  params,
}: PageProps) {
  const {
    city,
    category,
    subcategory,
  } = await params;

  /* ----------------------------------------------------------
     Validate City
     ---------------------------------------------------------- */

  const cityData = LOCATIONS.find(
    (item) => item.slug === city
  );

  if (!cityData) {
    notFound();
  }

  /* ----------------------------------------------------------
     Validate Category
     ---------------------------------------------------------- */

  const categoryData = CATEGORIES.find(
    (item) => item.slug === category
  );

  if (!categoryData) {
    notFound();
  }

  /* ----------------------------------------------------------
     Validate Subcategory
     ---------------------------------------------------------- */

  const subcategoryData =
    categoryData.subcategories.find(
      (item) => item.slug === subcategory
    );

  if (!subcategoryData) {
    notFound();
  }

  /* ----------------------------------------------------------
     Resolve Actual Service
     ---------------------------------------------------------- */

  const serviceData = SERVICES.find(
    (service) => service.slug === subcategory
  );

  if (!serviceData) {
    notFound();
  }

  /* ----------------------------------------------------------
     Validate Service Hierarchy
     ---------------------------------------------------------- */

  if (
    serviceData.category !== categoryData.slug ||
    serviceData.subcategory !== subcategoryData.slug
  ) {
    notFound();
  }

  /* ----------------------------------------------------------
     Validate Service Availability
     ---------------------------------------------------------- */

  const availableAreas = getAreasForService(
    city,
    serviceData.slug
  );

  if (availableAreas.length === 0) {
    notFound();
  }

  /* ----------------------------------------------------------
     Resolve Registry Configuration
     ---------------------------------------------------------- */

  const registryData =
    SERVICE_REGISTRY[serviceData.slug];

  if (!registryData) {
    notFound();
  }

  /* ----------------------------------------------------------
     Resolve Service Sections
     ---------------------------------------------------------- */

  const sections =
    registryData.sections ?? [];

  if (sections.length === 0) {
    notFound();
  }

  /* ----------------------------------------------------------
     Render
     ---------------------------------------------------------- */

  return (
    <SubcategoryLayout
      city={city}
      subcategory={subcategoryData}
      sections={sections}
      banner={registryData.banner}
    />
  );
}